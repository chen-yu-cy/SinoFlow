# FILE: Caddyfile
{$DOMAIN_NAME::80} {
  request_body {
    max_size 2048MB
  }

  # 启用高效 Zstandard 与 Gzip 压缩，显著降低跨国传输带宽与 TTFB
  encode zstd gzip

  # 针对 Next.js 哈希静态资源配置 1 年长效不变缓存
  @static path /_next/static/*
  header @static Cache-Control "public, max-age=31536000, immutable"

  log {
    output stdout
    format json
  }

  reverse_proxy app:3000
}

{$GRAFANA_DOMAIN:grafana.155-248-203-114.sslip.io} {
  header {
    # 限制仅允许 SinoFlow 主站域名内嵌 iframe，彻底杜绝任意第三方钓鱼网站点击劫持 (Clickjacking)
    Content-Security-Policy "frame-ancestors 'self' https://155-248-203-114.sslip.io http://localhost:3000 http://localhost"
  }
  reverse_proxy grafana:3000
}
