# FILE: Caddyfile
{$DOMAIN_NAME::80} {
  request_body {
    max_size 2048MB
  }

  log {
    output stdout
    format json
  }

  reverse_proxy app:3000
}

{$GRAFANA_DOMAIN:grafana.155-248-203-114.sslip.io} {
  header {
    # 限制仅允许 SinoFlow 主站域名内嵌 iframe，彻底杜绝任意第三方钓鱼网站点击劫持 (Clickjacking)
    Content-Security-Policy "frame-ancestors 'self' https://155-248-203-114.sslip.io http://localhost:3000 http://localhost"
  }
  reverse_proxy grafana:3000
}
