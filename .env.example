# FILE: .env.example
# ==============================================================================
# SinoFlow 全局环境变量与预设凭证配置模板
# 部署时请复制为 .env：`cp .env.example .env` 并修改以下密码与密钥
# ==============================================================================

# 1. PostgreSQL 数据库凭证 (用于 Docker db 容器及本地连接)
POSTGRES_USER="devuser"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
POSTGRES_DB="sinoflow_db"

# 本地开发连接地址 (Docker Compose 启动时 app 容器会自动使用上面的变量拼接 @db:5432)
DATABASE_URL="postgresql://devuser:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/sinoflow_db?schema=public"

# 2. NextAuth 身份认证与 JWT 签名密钥 (请使用 `openssl rand -base64 32` 生成)
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
AUTH_TRUST_HOST="true"

# 3. 网站初始管理员预设账号 (执行 `prisma/seed.ts` 时注入)
ADMIN_EMAIL="admin@sinoflow.cn"
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
ADMIN_NAME="Administrator"

# 4. Grafana 日志监控后台预设登录凭证 (http://localhost:3001)
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="CHANGE_ME_GRAFANA_PASSWORD"

# 5. 客服工单通知邮箱与日志级别配置
SUPPORT_EMAIL="support@sinoflow.com"
LOG_LEVEL="info"

# 6. Caddy 域名与自动 HTTPS 配置 (默认 :80 支持 IP 直接访问；绑定域名后改为如 sinoflow.com 即可自动开启 HTTPS)
DOMAIN_NAME=":80"

