generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  thumbnail   String?
  price       Float
  level       String   @default("入门级")
  duration    String   @default("20 课时")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  orders      Order[]
}

model Lesson {
  id        String       @id @default(cuid())
  title     String
  videoUrl  String
  order     Int
  status    LessonStatus @default(READY)
  courseId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  course    Course       @relation(fields: [courseId], references: [id])
}

enum LessonStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  courseId  String
  amount    Float
  status    OrderStatus @default(PENDING)
  paymentId String?     @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  course    Course      @relation(fields: [courseId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}
